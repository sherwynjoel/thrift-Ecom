# Database (if you set connection_limit in the URL, keep it at 5 or more: refunds hold a connection while calling Razorpay)
DATABASE_URL="postgresql://thrift:thrift@localhost:5432/thrift"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Adapters: local|s3 and console|ses|smtp
STORAGE_DRIVER="local"
EMAIL_DRIVER="console"
EMAIL_FROM="no-reply@example.com"

# SMTP (only when EMAIL_DRIVER=smtp), e.g. smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=""

# S3 (only when STORAGE_DRIVER=s3; AWS_REGION is also used by EMAIL_DRIVER=ses)
AWS_REGION="ap-south-1"
S3_BUCKET=""
S3_PUBLIC_BASE_URL=""

# Payments: mock (dev/e2e, refused in production) | razorpay
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cron: POST /api/cron/<job> with "Authorization: Bearer $CRON_SECRET" (see README → Cron)
CRON_SECRET="replace-with-openssl-rand-hex-32"

# Seed admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
