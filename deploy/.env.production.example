# deploy/.env — production settings. Copy from deploy/.env.production.example, fill in, `chmod 600 deploy/.env`.
# Used by docker compose for both variable substitution and the app's environment. Never commit the real file.
# The app REFUSES TO START in production until every line marked [required] is filled in (src/server/env-check.ts);
# deploy/deploy.sh checks the same list before it builds.
# Set by docker-compose.prod.yml, not here: DATABASE_URL, NEXT_PUBLIC_SITE_URL (https://DOMAIN), AUTH_URL, AUTH_TRUST_HOST, NODE_ENV.

# ---- Domain and HTTPS (Caddy gets a Let's Encrypt certificate for DOMAIN automatically) [required]
DOMAIN=shop.example.com
ACME_EMAIL=owner@example.com

# ---- Database (internal to the Docker network; use hex so the password is URL-safe: openssl rand -hex 24) [required]
POSTGRES_USER=thrift
POSTGRES_DB=thrift
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# ---- Auth.js (openssl rand -base64 32) [required]. Google sign-in is optional.
AUTH_SECRET=replace-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Image storage: local (uploads volume, included in backups) or s3
STORAGE_DRIVER=local
# AWS_REGION is used by STORAGE_DRIVER=s3, EMAIL_DRIVER=ses [required for ses] and the S3 backup copy.
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# ---- Email [required]: EMAIL_DRIVER must be smtp (with SMTP_URL) or ses; console is refused in production. EMAIL_DRIVER=disabled skips all emails until a sender is set up.
# See docs/deploy/aws-ec2.md → Email.
EMAIL_DRIVER=smtp
EMAIL_FROM=orders@example.com
SMTP_URL=

# ---- Payments [required]: Razorpay Test-mode keys are enough to start; swap in Live keys to go live,
# then `bash deploy/deploy.sh --restart`. Before you have keys, PAYMENT_PROVIDER=disabled runs the store with checkout showing "payments open soon". The webhook secret is one you generate (openssl rand -hex 32) and paste in both places.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cron (the cron container sends this as a bearer token to /api/cron/<job>; at least 32 characters: openssl rand -hex 32) [required]
CRON_SECRET=replace-with-openssl-rand-hex-32

# ---- Analytics (optional; baked in at build time, so run `bash deploy/deploy.sh --no-pull` after changing)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Backups (daily; kept this many days in the `backups` volume; optional off-box copy to S3)
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=thrift

# ---- Seed admin (optional default email for deploy/seed-admin.sh; the password is always typed, never stored)
ADMIN_EMAIL=
